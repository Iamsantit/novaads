# Backend (opcional — sólo si lo levantas por separado)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# === Verificación por email ===
VERIFICATION_SECRET=dev-only-change-me-please

# --- Provider selection ---
# Si omites EMAIL_PROVIDER, el sistema auto-detecta según qué keys tengas.
# Opciones: resend | gmail | smtp | console
# EMAIL_PROVIDER=gmail

# Dirección "From" que aparece en los emails
EMAIL_FROM=NovaAds <noreply@novaads.ai>

# --- Opción A · Resend (recomendado prod con dominio verificado) ---
RESEND_API_KEY=

# --- Opción B · Gmail SMTP (rápido para testing, 500/día) ---
# Requiere 2FA activado + App Password en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Opción C · SMTP genérico (Brevo, Mailgun, Postmark, SES, etc.) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# === OAuth conectores (cada uno es opcional) ===
# Si dejas las claves vacías, la UI muestra instrucciones de setup al usuario.

# Shopify — https://partners.shopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Wix — https://dev.wix.com
WIX_APP_ID=
WIX_APP_SECRET=

# WordPress.com — https://developer.wordpress.com/apps/
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# Meta (Facebook / Instagram Ads) — https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=

# Google Ads — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Ads — https://business-api.tiktok.com
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC_MONTH=
STRIPE_PRICE_BASIC_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PREMIUM_MONTH=
STRIPE_PRICE_PREMIUM_YEAR=
